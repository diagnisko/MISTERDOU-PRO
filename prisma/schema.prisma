// MISTERDOU-PRO — Schéma Prisma Phase 1 (26 tables)

generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { CLIENT SELLER STAFF ADMIN }
enum UserStatus { ACTIVE LIMITED SUSPENDED DELETED }
enum AuthProvider { EMAIL GOOGLE }
enum KycStatus { PENDING SUBMITTED UNDER_REVIEW APPROVED REJECTED }
enum KycDocType { CNI PASSPORT PERMIS_CONDUIRE }
enum SellerStatus { PENDING APPROVED SUSPENDED REJECTED }
enum ProductType { ADMIN_ACCOUNT SELLER_ACCOUNT }
enum ProductStatus { DRAFT PENDING_REVIEW PUBLISHED RESERVED SOLD ARCHIVED REJECTED }
enum OrderStatus { PENDING CONFIRMED CREDENTIALS_DELIVERED COMPLETED CANCELLED REFUNDED DISPUTED }
enum PaymentStatus { INITIATED SUCCEEDED FAILED CANCELLED REFUNDED }
enum PaymentType { FULL INITIAL_DEPOSIT INSTALLMENT }
enum InstallmentStatus { SCHEDULED PAYMENT_LINK_SENT PAID OVERDUE CANCELLED }
enum WithdrawalStatus { PENDING APPROVED PAID REJECTED }
enum TicketStatus { OPEN IN_PROGRESS RESOLVED CLOSED }
enum NotificationChannel { IN_APP EMAIL }
enum Currency { XOF }

model User {
  id               String       @id @default(uuid()) @db.Uuid
  email            String       @unique
  emailVerified    Boolean      @default(false)
  passwordHash     String?
  authProvider     AuthProvider @default(EMAIL)
  googleId         String?      @unique
  firstName        String?
  lastName         String?
  phone            String? // profil/KYC uniquement, jamais un moyen de connexion
  status           UserStatus   @default(ACTIVE)
  role             UserRole     @default(CLIENT)
  twoFactorSecret  String?
  twoFactorEnabled Boolean      @default(false)
  failedLogins     Int          @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sessions          Session[]
  kyc               IdentityVerification?
  seller            Seller?
  orders            Order[]
  installmentPlans  InstallmentPlan[]
  supportTickets   SupportTicket[]
  notifications     Notification[]
  notificationPrefs NotificationPref?
  auditLogs        AuditLog[]

  @@index([status])
  @@index([role])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model IdentityVerification {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  status          KycStatus @default(PENDING)
  docType         KycDocType?
  docNumber       String?
  docFrontKey     String? // clés objets R2 bucket PRIVE misterdou-kyc
  docBackKey      String?
  selfieKey       String?
  selfieMatched   Boolean?
  rejectionReason String?
  reviewedBy      String?   @db.Uuid
  reviewedAt      DateTime?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  history VerificationHistory[]

  @@index([status])
}

model VerificationHistory {
  id             String    @id @default(uuid()) @db.Uuid
  verificationId String    @db.Uuid
  previousStatus KycStatus
  newStatus      KycStatus
  comment        String?
  actorId        String?   @db.Uuid
  createdAt      DateTime  @default(now())
  verification   IdentityVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  @@index([verificationId])
}

model Seller {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @unique @db.Uuid
  shopName       String
  slug           String       @unique
  description    String?
  status         SellerStatus @default(PENDING)
  balance        Decimal      @default(0) @db.Decimal(12, 2)
  pendingBalance Decimal      @default(0) @db.Decimal(12, 2) // séquestre anti-fraude
  totalSales     Decimal      @default(0) @db.Decimal(12, 2)
  rating         Decimal?     @db.Decimal(3, 2)
  salesCount     Int          @default(0)
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products      Product[]
  withdrawals   Withdrawal[]
  balanceEvents SellerBalanceEvent[]
  @@index([status])
}

model SellerBalanceEvent {
  id           String   @id @default(uuid()) @db.Uuid
  sellerId     String   @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  type         String // SALE | COMMISSION | PAYOUT | REFUND | ADJUSTMENT
  balanceAfter Decimal  @db.Decimal(12, 2)
  orderId      String?  @db.Uuid
  description  String?
  createdAt    DateTime @default(now())
  seller       Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  @@index([sellerId])
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  type            ProductType   @default(SELLER_ACCOUNT)
  sellerId        String?       @db.Uuid
  title           String
  slug            String        @unique
  description     String?
  price           Decimal       @db.Decimal(12, 2)
  currency        Currency      @default(XOF)
  status          ProductStatus @default(DRAFT)
  platform        String?
  level           Int?
  playersCount    Int?
  coins           Int?
  hasLegends      Boolean       @default(false)
  specialFeatures String?
  reviewNote      String?
  publishedAt     DateTime?
  soldAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  seller     Seller?            @relation(fields: [sellerId], references: [id])
  images     ProductImage[]
  credential ProductCredential?
  orderItems OrderItem[]
  featured   FeaturedProduct?
  @@index([status])
  @@index([type])
  @@index([sellerId])
  @@index([publishedAt])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  mediaType String // IMAGE | VIDEO
  objectKey String // bucket PUBLIC misterdou-media
  url       String // URL publique R2
  isCover   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

model ProductCredential {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @unique @db.Uuid
  cipherText  String // AES-256-GCM iv:authTag:cipher (base64)
  deliveredAt DateTime?
  deliveredTo String?  @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

model Promotion {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  label          String
  discountType   String // PERCENT | FIXED
  discountValue  Decimal   @db.Decimal(12, 2)
  minOrderAmount Decimal?  @db.Decimal(12, 2)
  maxUses        Int?
  usedCount      Int       @default(0)
  startsAt       DateTime
  endsAt         DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  promotionProducts PromotionProduct[]
  @@index([active])
}

model PromotionProduct {
  id          String @id @default(uuid()) @db.Uuid
  promotionId String @db.Uuid
  productId   String @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  @@unique([promotionId, productId])
}

model FeaturedProduct {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique @db.Uuid
  position  Int      @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean  @default(true)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([active, position])
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique
  userId      String      @db.Uuid
  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  currency    Currency    @default(XOF)
  promotionId String?     @db.Uuid
  notes       String?
  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  installmentPlan InstallmentPlan?
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @db.Uuid
  productId     String  @db.Uuid
  titleSnapshot String
  priceSnapshot Decimal @db.Decimal(12, 2)
  sellerId      String? @db.Uuid
  quantity      Int      @default(1)
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])
  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @db.Uuid
  type          PaymentType   @default(FULL)
  status        PaymentStatus @default(INITIATED)
  amount        Decimal       @db.Decimal(12, 2)
  currency      Currency      @default(XOF)
  provider      String        @default("paytech") // agrégateur en coulisses — JAMAIS exposé au client
  channel       String? // canal choisi par le client : WAVE | OM (Wave / Orange Money)
  providerRef   String?       @unique
  installmentId String?       @db.Uuid
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order         @relation(fields: [orderId], references: [id])
  events        PaymentEvent[]
  @@index([orderId])
  @@index([status])
}

model PaymentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @db.Uuid
  providerRef String
  eventType   String
  payload     Json
  processedAt DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@unique([providerRef, eventType]) // idempotence webhooks
  @@index([paymentId])
}

model InstallmentPlan {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @unique @db.Uuid
  userId        String  @db.Uuid
  months        Int
  depositAmount Decimal @db.Decimal(12, 2)
  totalAmount   Decimal @db.Decimal(12, 2)
  monthlyAmount Decimal @db.Decimal(12, 2)
  status        String  @default("ACTIVE")
  // Offres ADMIN : identifiants remis dès l'apport initial payé
  credentialsDelivered Boolean @default(false)
  createdAt    DateTime @default(now())
  user          User          @relation(fields: [userId], references: [id])
  installments  Installment[]
  @@index([userId])
  @@index([status])
}

model Installment {
  id                String            @id @default(uuid()) @db.Uuid
  planId            String            @db.Uuid
  sequence          Int
  dueDate           DateTime
  amount            Decimal           @db.Decimal(12, 2)
  status            InstallmentStatus @default(SCHEDULED)
  payLinkSentAt     DateTime?
  paidAt            DateTime?
  lastReminderSentAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  plan     InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@unique([planId, sequence])
  @@index([status, dueDate])
}

model Withdrawal {
  id          String           @id @default(uuid()) @db.Uuid
  sellerId    String           @db.Uuid
  amount      Decimal          @db.Decimal(12, 2)
  status      WithdrawalStatus @default(PENDING)
  method      String // WAVE | OM | BANK
  destination String
  reference   String?
  fee         Decimal          @default(200) @db.Decimal(12, 2)
  requestedAt DateTime         @default(now())
  processedAt DateTime?
  notes       String?
  seller      Seller           @relation(fields: [sellerId], references: [id])
  @@index([sellerId])
  @@index([status])
}

model SupportTicket {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  orderId   String?      @db.Uuid
  subject   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user          User          @relation(fields: [userId], references: [id])
  messages      Message[]
  @@index([userId])
  @@index([status])
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  senderId  String?  @db.Uuid
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId])
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  read      Boolean             @default(false)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, read])
}

model NotificationPref {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(true)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Settings {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique
  value Json
  updatedAt DateTime @updatedAt
}
