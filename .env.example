# =============================================================
# MISTERDOU-PRO — Variables d'environnement (exemple)
# Copier en .env et renseigner. JAMAIS de secrets réels dans le dépôt.
# =============================================================

# --- Application ---
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://misterdou:misterdou@localhost:5432/misterdou?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Stockage Cloudflare R2 ---
# Bucket PRIVÉ (KYC) : aucune URL publique, accès par URLs signées 60 s
# Bucket PUBLIC (médias offres) : activer "Public Access" dans le dashboard R2
R2_ACCOUNT_ID=your-cloudflare-account-id
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=your-r2-access-key-id
S3_SECRET_KEY=your-r2-secret-access-key
S3_BUCKET_KYC=misterdou-kyc
SIGNED_URL_TTL=60
S3_BUCKET_MEDIA=misterdou-media
S3_BUCKET_MEDIA_PUBLIC_URL=https://pub-xxxx.r2.dev
MEDIA_MAX_IMAGE_MB=5
MEDIA_MAX_VIDEO_MB=50
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
ALLOWED_VIDEO_TYPES=mp4,webm

# Dev hors ligne seulement (profil local-storage) : remplacer par :
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# --- JWT / sessions ---
JWT_ACCESS_SECRET=change-me-64-chars-min
JWT_REFRESH_SECRET=change-me-too-64-chars-min
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Chiffrement identifiants eFootball (AES-256-GCM) ---
EFCRED_MASTER_KEY=base64-32-bytes-random-key

# --- Google OAuth (connexion : Google OU e-mail/mot de passe) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- PayTech ---
PAYTECH_API_KEY=
PAYTECH_SECRET_KEY=
PAYTECH_BASE_URL=https://paytech.sn
PAYTECH_WEBHOOK_SECRET=

# --- E-mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@misterdou.pro

# --- Rate limiting ---
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=5
